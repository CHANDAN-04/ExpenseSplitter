# ========================================================
# Expense Splitter Backend - Environment Configuration
# ========================================================
# 
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ========================================================
# JWT Configuration (REQUIRED)
# ========================================================

# Secret key for signing JWT tokens (32+ characters recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_secret_minimum_32_characters

# Access token expiration (short-lived)
JWT_ACCESS_EXPIRY=15m

# Refresh token expiration (long-lived)
JWT_REFRESH_EXPIRY=7d

# Legacy: Full token expiration (deprecated, kept for backward compatibility)
JWT_EXPIRES_IN=7d

# ========================================================
# Database Configuration (REQUIRED)
# ========================================================

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/expense-splitter
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/expense-splitter

# ========================================================
# Node Environment (REQUIRED)
# ========================================================

# Values: development, production, test
NODE_ENV=development

# ========================================================
# Client/Frontend Configuration (REQUIRED)
# ========================================================

# Frontend URL for CORS and email links
CLIENT_URL=http://localhost:3000

# ========================================================
# Cloudinary Image Hosting (REQUIRED for bill uploads)
# ========================================================

# Get these from: https://cloudinary.com/console/settings/general
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================================================
# Razorpay Payment Integration (REQUIRED for payments)
# ========================================================

# Get these from: https://dashboard.razorpay.com/app/settings/api-keys
# For testing, use sandbox keys
# For production, use live keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ========================================================
# Server Configuration (OPTIONAL)
# ========================================================

# Server port
PORT=5000

# ========================================================
# CORS Configuration (OPTIONAL)
# ========================================================

# Additional CORS origins (comma-separated)
# By default, CLIENT_URL is allowed
# CORS_ADDITIONAL_ORIGINS=https://example.com,https://admin.example.com

# ========================================================
# Rate Limiting (OPTIONAL - auto-configured)
# ========================================================

# Enable rate limiting (true/false)
# Disabled in development, enabled in production
ENABLE_RATE_LIMITING=false

# ========================================================
# Logging (OPTIONAL)
# ========================================================

# Log level: error, warn, info, http, debug, silly
LOG_LEVEL=info

# ========================================================
# QUICK START
# ========================================================

# 1. Copy this file: cp .env.example .env
# 2. Update REQUIRED variables above (marked with REQUIRED)
# 3. Run: npm install && npm start
# 4. Check output for ✓ validation messages
#
# See SETUP.md for detailed configuration instructions
# See SECURITY.md for security best practices
# See DEPLOYMENT.md for production deployment
